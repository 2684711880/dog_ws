        xyz="0.146784625607594 2.85389443858419E-05 -0.0451509288562181"
        rpy="0 0 0" />
      <mass
        value="0.277311011952886" />
      <inertia
        ixx="9.95674146018043E-05"
        ixy="1.53492555085754E-08"
        ixz="0.00016958851410684"
        iyy="0.000746548130244516"
        iyz="-1.23849038994561E-08"
        izz="0.000654352023817114" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://dog_control/meshes/RB_Link_3.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
